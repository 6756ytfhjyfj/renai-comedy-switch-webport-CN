[tb_start_text mode=1 ]
#影野維月
別にいいけど……[p]
……あ、むうにゃんのガチャもあるじゃん……[p]

#私
ほんとだ、かわいい！影野くんも回してけば？[p]
[_tb_end_text]

[chara_part  name="影野維月"  time="0"  gomuu="タ_ウナー立ち絵3_20260507185643.png"  aozame="タ_ウナー立ち絵_20260125174156.png"  ase="none"  me="タ_ウナー立ち絵_20260125174103.png"  mayu="タ_ウナー立ち絵_20260125192908.png"  kuti="タ_ウナー立ち絵_20260125192636.png"  ]
